server {
    listen 8081;

    location = /healthz {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location = /metrics {
        proxy_pass http://loklingo-backend:8080/api/v1/metrics/prometheus;
        proxy_set_header X-Internal-Token "$INTERNAL_TOKEN";
        proxy_set_header Host $host;
        proxy_http_version 1.1;
    }
}
