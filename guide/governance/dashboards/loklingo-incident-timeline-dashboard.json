          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "increase(loklingo_pipeline_failovers_total[5m])",
          "legendFormat": "pipeline_failovers",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "increase(loklingo_pipeline_timeouts_total[5m])",
          "legendFormat": "pipeline_timeouts",
          "range": true,
          "refId": "C"
        }
