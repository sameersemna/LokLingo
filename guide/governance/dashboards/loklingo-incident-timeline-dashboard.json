          "editorMode": "code",
          "expr": "sum by (provider) (increase(loklingo_provider_timeout_total[5m]))",
          "legendFormat": "timeouts {{provider}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (provider) (increase(loklingo_provider_retry_total[5m]))",
          "legendFormat": "retries {{provider}}",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum by (provider) (increase(loklingo_provider_failover_total[5m]))",
          "legendFormat": "failovers {{provider}}",
          "range": true,
          "refId": "C"
        }
      ],
