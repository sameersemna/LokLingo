        "code": {
          "language": "bash",
          "showLineNumbers": true,
          "showMiniMap": false
        },
        "content": "# Set at least one variable before running\\n# correlation_id=${correlation_id}\\n# job_id=${job_id}\\n\\ncurl -s \"http://localhost:28080/api/v1/metrics/lifecycle/events?correlation_id=${correlation_id}&job_id=${job_id}&limit=200\" \\\\n  -H \"X-Internal-Token: $INTERNAL_TOKEN\" | jq .",
        "mode": "markdown"
      },
