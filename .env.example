# LokLingo environment configuration
# Copy this file to .env and fill in real values

# Environment: development | production (default: development)
APP_ENV=development

# Go Backend
PORT=8080
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# LiteLLM Gateway (running on latitude or external)
LITELLM_BASE_URL=http://your-litellm-host:4000
LITELLM_API_KEY=sk-loklingo
LITELLM_MODEL=gpt-4o-mini

# OCR Service (use service DNS in docker-compose; use LAN host/IP only when backend runs outside compose)
OCR_SERVICE_URL=http://loklingo-ocr:8000
# OCR provider selection for pluggable OCR chain: paddle | tesseract | ollama
OCR_PROVIDER=paddle
# Max seconds allowed per OCR provider attempt before failover
OCR_PROVIDER_TIMEOUT_SECONDS=120
# Max number of provider failovers allowed per OCR request
OCR_MAX_FALLBACKS=2
OCR_HOST_PORT=8000
# LLM post-correction of low-confidence OCR lines (served by the OCR container)
OCR_CORRECTION_ENABLED=false
OCR_CORRECTION_MODEL=Keyvan/german-ocr
# Comma-separated ISO 639-1 codes eligible for correction; "auto" = no lang hint
OCR_CORRECTION_LANGS=de,auto
# Reject corrected lines below this similarity ratio vs. the raw OCR line (hallucination guard)
OCR_CORRECTION_MIN_SIMILARITY=0.55
# VLM OCR fallback: re-OCR low-confidence Arabic-script pages with a local VLM via Ollama
OCR_VLM_FALLBACK_ENABLED=false
OCR_VLM_MODEL=qwen2.5-vl
OCR_VLM_LANGS=ar,ur,fa,he
OCR_VLM_CONFIDENCE_THRESHOLD=0.72
OCR_VLM_TIMEOUT=60
# Optional Surya engine (middle fallback tier; needs surya-ocr + torch installed)
OCR_SURYA_ENABLED=false
OCR_SURYA_LANGS=ar,ur,hi,bn,fa
OCR_SURYA_CONFIDENCE_THRESHOLD=0.72
# Ensemble: merge PaddleOCR + Surya blocks by bbox overlap, higher confidence wins
OCR_ENSEMBLE_ENABLED=false
OCR_ENSEMBLE_IOU_THRESHOLD=0.3

# Observability stack (docker-compose.observability.yml)
PROMETHEUS_HOST_PORT=29090
GRAFANA_HOST_PORT=23000
METRICS_PROXY_HOST_PORT=18081
# REQUIRED in production (min 24 chars, no placeholders). Generate: openssl rand -hex 32
# Also baked into the frontend bundle as VITE_INTERNAL_TOKEN at build time so the
# UI can authenticate against internal routes (metrics, dead ops). Keep it in sync
# with the backend value.
INTERNAL_TOKEN=replace-me-for-local-dev
GRAFANA_ADMIN_USER=admin
# Never ship Grafana with password "admin" on a shared LAN
GRAFANA_ADMIN_PASSWORD=admin

# Write API protection (required in production; min 24 chars)
# Send via X-API-Token or Authorization: Bearer <token>
# Generate: openssl rand -hex 32
WRITE_API_TOKEN=

# Route traffic controls (prod overlay tightens these further)
GLOBAL_RATE_LIMIT_PER_MINUTE=120
WRITE_RATE_LIMIT_PER_MINUTE=40
UPLOAD_RATE_LIMIT_PER_MINUTE=12
SYNC_IMAGE_MAX_INFLIGHT=8

# See also: guide/security-hardening.md, scripts/self-heal.sh, scripts/backup-restore.sh

# Frontend reliability mini-widget thresholds (build-time Vite env)
VITE_RELIABILITY_PRESSURE_WARN=8
VITE_RELIABILITY_PRESSURE_CRITICAL=20

# Redis
# When running locally with docker-compose.dev.yml, this is set automatically.
# For production (or running the backend outside Docker), set this explicitly.
REDIS_URL=redis://localhost:6379

# Worker translation throughput and chunking
# Controls max in-flight LLM requests from the worker.
TRANSLATE_CONCURRENCY=3
# PDF translation chunks target this minimum number of words.
TRANSLATE_CHUNK_MIN_WORDS=80
# Hard cap for PDF translation chunk size (must be >= min words).
TRANSLATE_CHUNK_MAX_WORDS=150
